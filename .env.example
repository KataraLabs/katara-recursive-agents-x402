# test: test USDC on Avalanche Fuji through https://api.katara.com/test. New wallets start here.
# live: native USDC on Avalanche C-Chain through https://api.katara.com. Also used when this line is removed.
# Both pay each call with x402 from this wallet. Gateways, chains, tokens and contracts are fixed in src/config.ts.
KATARA_MODE=test
# Optional. Leave empty to use Avalanche's public RPC endpoint, which rate limits busy addresses.
# Set your own HTTPS endpoint for the mode's chain (C-Chain for live, Fuji for test) if runs stop with rpc_http_429.
AVALANCHE_RPC_URL=
KATARA_BUYER_ADDRESS=
KATARA_BUYER_KEY=

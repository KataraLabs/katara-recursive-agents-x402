        },
        "confirmedUnits": {
          "type": "string",
          "description": "Confirmed net charges in USDC base units, excluding pending authorizations."
        },
        "pendingUnits": {
          "type": "string",
          "description": "Maximum amounts still reserved; these authorizations may yet settle."
        },
        "htmlPath": {
          "type": "string"
